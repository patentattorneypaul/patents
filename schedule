/* ====== Begin Page CSS ====== */
:root {
  --magenta: #e83e8c;
  --purple: #5f27cd;
  --coral: #ff6f61;
  --gold: #ffd166;
  --text: #2b2b2b;
  --muted: #6b7280;
  --bg: #ffffff;
  --card: rgba(255, 255, 255, 0.98);
  --border: #eef0f4;
  --shadow: 0 10px 30px rgba(0, 0, 0, 0.07);
}

.ssf-schedule {
  color: var(--text);
  background: var(--bg);
}
/* Add spacing before secondary services section */
.secondary-services {
  margin-top: clamp(40px, 6vw, 80px);
  padding-bottom: clamp(40px, 6vw, 80px);
}

/* ====== Containers ====== */
.container {
  margin-inline: auto;
  padding-inline: clamp(16px, 4vw, 40px);
}
.container.narrow {
  max-width: 70ch;
}
.container.standard {
  max-width: clamp(960px, 90vw, 1400px);
}
.container.wide {
  max-width: clamp(1200px, 90vw, 1800px);
} /* 3 cards fit at 1920 */

/* ====== Hero ====== */
.hero h1 {
  font-weight: 800;
  line-height: 1.1;
  font-size: clamp(2.2rem, 5vw, 3.4rem);
  margin-bottom: 10px;
}
.gradient-text {
  background: linear-gradient(135deg, var(--magenta), var(--purple));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.hero-sub {
  font-size: clamp(1rem, 2.3vw, 1.25rem);
  color: var(--text);
  opacity: 0.9;
}
.hero-cta {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 18px;
}
.note {
  margin-top: 14px;
  font-size: 0.95rem;
  color: var(--muted);
}

/* Center hero CTAs on small screens */
@media (max-width: 720px) {
  .hero-cta {
    justify-content: center;
    text-align: center;
  }
  .hero-cta a {
    flex: 1 1 auto; /* allow equal width growth */
    max-width: 280px; /* optional: cap button width */
  }
}

/* ====== Grid of Service Cards ====== */
.cards-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: clamp(14px, 2vw, 22px);
}
.cards-grid .service-card {
  width: 100%;
}

@media (max-width: 1200px) {
  .cards-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media (max-width: 720px) {
  .cards-grid {
    grid-template-columns: 1fr;
  }
}

/* ====== Card Styles ====== */
.card {
  background: var(--card);
  border-radius: 22px;
  box-shadow: var(--shadow);
  padding: clamp(18px, 2.2vw, 26px);
  border: 1px solid var(--border);
  position: relative;
  overflow: hidden;
}
.card::before {
  content: "";
  position: absolute;
  inset: 0 0 auto 0;
  height: 5px;
  background: linear-gradient(
    90deg,
    var(--magenta),
    var(--purple),
    var(--coral),
    var(--gold)
  );
  opacity: 0.9;
}
.card-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 8px;
}
.card-header h2 {
  font-size: clamp(1.25rem, 2.5vw, 1.75rem);
  margin: 0;
}
.icon-badge {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--magenta), var(--purple));
  color: #fff;
  font-size: 20px;
}

.lead {
  color: var(--text);
  opacity: 0.9;
  margin-top: 6px;
}
.highlights {
  margin: 12px 0 6px;
  padding-left: 1.1em;
}
.highlights li {
  margin: 6px 0;
}
.inline-cta {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 12px;
}

.hours-pill {
  margin: 12px 0;
  padding: 10px 14px;
  border-radius: 12px;
  background: #f8f9fb;
  border: 1px solid var(--border);
  font-size: 0.98rem;
}

.seo-copy {
  margin-top: 12px;
  color: var(--muted);
  font-size: 0.95rem;
}

/* ====== Secondary Services Chips ====== */
.secondary-services h3 {
  margin-bottom: 10px;
  font-size: clamp(1.1rem, 2vw, 1.35rem);
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  padding: 0;
  list-style: none;
}
.chips a {
  display: inline-block;
  padding: 8px 12px;
  border-radius: 999px;
  text-decoration: none;
  color: var(--purple);
  border: 1.5px solid var(--purple);
  font-weight: 700;
  background: #fff;
}
.chips a:hover {
  transform: translateY(-1px);
}

/* ====== Differentiators / Comparison ====== */
.compare {
  padding-top: 0;
}
.compare-card {
  background: linear-gradient(
    135deg,
    rgba(232, 62, 140, 0.08),
    rgba(95, 39, 205, 0.08)
  );
  border: 1px solid var(--border);
  border-radius: 22px;
  padding: clamp(18px, 2.2vw, 26px);
  box-shadow: var(--shadow);
}
.ticks {
  list-style: none;
  padding-left: 0;
}
.ticks li::before {
  content: "✔";
  margin-right: 8px;
  color: var(--purple);
  font-weight: 800;
}

/* ====== Final CTA ====== */
.final-cta {
  text-align: center;
  padding-top: 16px;
}
.final-cta h3 {
  font-size: clamp(1.6rem, 3.2vw, 2.2rem);
  margin: 0 0 8px;
}
.final-cta p {
  color: var(--muted);
  margin-bottom: 12px;
}
.final-cta .hero-cta {
  justify-content: center;
  text-align: center;
}

/* ====== Accessibility Helper ====== */
.sr-only {
  position: absolute !important;
  height: 1px;
  width: 1px;
  overflow: hidden;
  clip: rect(1px, 1px, 1px, 1px);
  white-space: nowrap;
}


/* ====== Booking Policy Section ====== */
.booking-policy-section {
  margin-top: clamp(40px, 6vw, 60px);
  margin-bottom: clamp(40px, 6vw, 60px);
}

.booking-policy-card {
  background: var(--card);
  border-radius: 22px;
  box-shadow: var(--shadow);
  padding: clamp(18px, 2.2vw, 26px);
  border: 1px solid var(--border);
  position: relative;
  overflow: hidden;
}

/* Top gradient accent bar (matching service cards) */
.booking-policy-card::before {
  content: "";
  position: absolute;
  inset: 0 0 auto 0;
  height: 5px;
  background: linear-gradient(
    90deg,
    var(--magenta),
    var(--purple),
    var(--coral),
    var(--gold)
  );
  opacity: 0.9;
}

/* Header styling (consistent with service cards) */
.booking-policy-card .card-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}

.booking-policy-card .card-header h2 {
  font-size: clamp(1.25rem, 2.5vw, 1.75rem);
  margin: 0;
  color: var(--text);
}

/* Introduction text */
.policy-intro {
  margin-bottom: 24px;
  color: var(--text);
  opacity: 0.9;
}

.policy-intro p {
  margin-bottom: 12px;
  line-height: 1.6;
}

.policy-intro a {
  color: var(--purple);
  text-decoration: none;
  font-weight: 600;
}

.policy-intro a:hover {
  text-decoration: underline;
}

/* Policy summary (highlighted section) */
.policy-summary {
  background: #f8f9fb;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 24px;
}

.policy-summary p {
  margin: 0;
  color: var(--text);
  line-height: 1.6;
}

/* Policy grid for service-specific rules */
.policy-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: clamp(14px, 2vw, 20px);
}

@media (max-width: 768px) {
  .policy-grid {
    grid-template-columns: 1fr;
  }
}

/* Individual policy service cards */
.policy-service {
  background: rgba(95, 39, 205, 0.03);
  border: 1px solid rgba(95, 39, 205, 0.15);
  border-radius: 12px;
  padding: 16px;
  transition: all 0.3s ease;
}

.policy-service:hover {
  border-color: var(--purple);
  background: rgba(95, 39, 205, 0.06);
  transform: translateY(-1px);
}

.policy-service h3 {
  color: var(--purple);
  font-size: 1.1rem;
  font-weight: 700;
  margin: 0 0 12px 0;
}

/* Policy lists */
.policy-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.policy-list li {
  margin: 6px 0;
  padding-left: 16px;
  position: relative;
  color: var(--text);
  font-size: 0.95rem;
  line-height: 1.4;
}

/* Custom bullet points */
.policy-list li::before {
  content: "•";
  color: var(--purple);
  font-weight: 700;
  position: absolute;
  left: 0;
}

/* Mobile responsiveness for booking policy */
@media (max-width: 720px) {
  .booking-policy-section {
    margin-top: clamp(30px, 5vw, 40px);
    margin-bottom: clamp(30px, 5vw, 40px);
  }
  
  .policy-service {
    padding: 14px;
  }
  
  .policy-service h3 {
    font-size: 1rem;
  }
  
  .policy-list li {
    font-size: 0.9rem;
  }
}

/* ================================
   SSF.Fit — On-Page Service Menu
   Paste into page CSS or global CSS
   ================================ */

/* Smooth scroll */
html { scroll-behavior:smooth; }

/* Offset clicked anchors for fixed header (adjust as needed) */
.svc-anchor { scroll-margin-top: var(--header-offset, 96px); }

/* Container */
.svc-onpage-nav {
  position: sticky; top: var(--header-gap, 72px);
  z-index: 30; /* stays under GP header but above content */
  background: #fff;
  border: 1px solid rgba(0,0,0,.06);
  border-radius: 14px;
  padding: 8px;
  margin: 16px 0 24px;
  box-shadow: 0 2px 10px rgba(0,0,0,.04);
}

/* List */
.svc-onpage-nav ul {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px,1fr));
  gap: 8px;
  list-style: none;
  margin: 0;
  padding: 0;
}

/* Links */
.svc-onpage-nav a {
  display: block;
  text-align: center;
  text-decoration: none;
  font-weight: 600;
  line-height: 1;
  padding: 12px 14px;
  border-radius: 10px;
  border: 1px solid rgba(0,0,0,.06);
  background: #fafafa;
  color: #2b2b2b;
  transition: transform .06s ease, background-color .15s ease, border-color .15s ease, color .15s ease;
}

/* Brand-aware colors with safe fallbacks */
.svc-onpage-nav a:hover,
.svc-onpage-nav a:focus-visible {
  background: var(--magenta, #E83E8C);
  color: #fff;
  border-color: var(--magenta, #E83E8C);
  transform: translateY(-1px);
  outline: none;
}

/* CTA pill */
.svc-onpage-nav a.cta {
  background: linear-gradient(135deg, var(--magenta, #E83E8C), var(--purple, #5F27CD));
  color: #fff;
  border-color: transparent;
}
.svc-onpage-nav a.cta:hover,
.svc-onpage-nav a.cta:focus-visible {
  filter: brightness(1.05);
}

/* :target highlight after jump (no JS) */
:target.svc-anchor::after {
  content: "";
  display: block;
  height: 0; margin-top: 12px;
  border-bottom: 3px solid var(--purple, #5F27CD);
}

/* Reduce stickiness on small screens */
@media (max-width: 768px) {
  .svc-onpage-nav { top: var(--header-gap-mobile, 56px); padding: 6px; }
  .svc-onpage-nav a { padding: 10px 12px; font-weight: 600; }
}

/* High-contrast focus for accessibility */
.svc-onpage-nav a:focus-visible { box-shadow: 0 0 0 3px rgba(95,39,205,.3); }

