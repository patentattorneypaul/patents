/* ====== Begin Page CSS ====== */
:root {
  --magenta: #e83e8c;
  --purple: #5f27cd;
  --coral: #ff6f61;
  --gold: #ffd166;
  --text: #2b2b2b;
  --muted: #6b7280;
  --bg: #ffffff;
  --card: rgba(255, 255, 255, 0.98);
  --border: #eef0f4;
  --shadow: 0 10px 30px rgba(0, 0, 0, 0.07);
}

.ssf-schedule {
  color: var(--text);
  background: var(--bg);
}
/* Add spacing before secondary services section */
.secondary-services {
  margin-top: clamp(40px, 6vw, 80px);
  padding-bottom: clamp(40px, 6vw, 80px);
}

/* ====== Containers ====== */
.container {
  margin-inline: auto;
  padding-inline: clamp(16px, 4vw, 40px);
}
.container.narrow {
  max-width: 70ch;
}
.container.standard {
  max-width: clamp(960px, 90vw, 1400px);
}
.container.wide {
  max-width: clamp(1200px, 90vw, 1800px);
} /* 3 cards fit at 1920 */

/* ====== Hero ====== */
.hero h1 {
  font-weight: 800;
  line-height: 1.1;
  font-size: clamp(2.2rem, 5vw, 3.4rem);
  margin-bottom: 10px;
}
.gradient-text {
  background: linear-gradient(135deg, var(--magenta), var(--purple));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.hero-sub {
  font-size: clamp(1rem, 2.3vw, 1.25rem);
  color: var(--text);
  opacity: 0.9;
}
.hero-cta {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 18px;
}
.note {
  margin-top: 14px;
  font-size: 0.95rem;
  color: var(--muted);
}

/* Center hero CTAs on small screens */
@media (max-width: 720px) {
  .hero-cta {
    justify-content: center;
    text-align: center;
  }
  .hero-cta a {
    flex: 1 1 auto; /* allow equal width growth */
    max-width: 280px; /* optional: cap button width */
  }
}

/* ====== Grid of Service Cards ====== */
.cards-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: clamp(14px, 2vw, 22px);
}
.cards-grid .service-card {
  width: 100%;
}

@media (max-width: 1200px) {
  .cards-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media (max-width: 720px) {
  .cards-grid {
    grid-template-columns: 1fr;
  }
}

/* ====== Card Styles ====== */
.card {
  background: var(--card);
  border-radius: 22px;
  box-shadow: var(--shadow);
  padding: clamp(18px, 2.2vw, 26px);
  border: 1px solid var(--border);
  position: relative;
  overflow: hidden;
}
.card::before {
  content: "";
  position: absolute;
  inset: 0 0 auto 0;
  height: 5px;
  background: linear-gradient(
    90deg,
    var(--magenta),
    var(--purple),
    var(--coral),
    var(--gold)
  );
  opacity: 0.9;
}
.card-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 8px;
}
.card-header h2 {
  font-size: clamp(1.25rem, 2.5vw, 1.75rem);
  margin: 0;
}
.icon-badge {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--magenta), var(--purple));
  color: #fff;
  font-size: 20px;
}

.lead {
  color: var(--text);
  opacity: 0.9;
  margin-top: 6px;
}
.highlights {
  margin: 12px 0 6px;
  padding-left: 1.1em;
}
.highlights li {
  margin: 6px 0;
}
.inline-cta {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 12px;
}

.hours-pill {
  margin: 12px 0;
  padding: 10px 14px;
  border-radius: 12px;
  background: #f8f9fb;
  border: 1px solid var(--border);
  font-size: 0.98rem;
}

.seo-copy {
  margin-top: 12px;
  color: var(--muted);
  font-size: 0.95rem;
}

/* ====== Secondary Services Chips ====== */
.secondary-services h3 {
  margin-bottom: 10px;
  font-size: clamp(1.1rem, 2vw, 1.35rem);
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  padding: 0;
  list-style: none;
}
.chips a {
  display: inline-block;
  padding: 8px 12px;
  border-radius: 999px;
  text-decoration: none;
  color: var(--purple);
  border: 1.5px solid var(--purple);
  font-weight: 700;
  background: #fff;
}
.chips a:hover {
  transform: translateY(-1px);
}

/* ====== Differentiators / Comparison ====== */
.compare {
  padding-top: 0;
}
.compare-card {
  background: linear-gradient(
    135deg,
    rgba(232, 62, 140, 0.08),
    rgba(95, 39, 205, 0.08)
  );
  border: 1px solid var(--border);
  border-radius: 22px;
  padding: clamp(18px, 2.2vw, 26px);
  box-shadow: var(--shadow);
}
.ticks {
  list-style: none;
  padding-left: 0;
}
.ticks li::before {
  content: "✔";
  margin-right: 8px;
  color: var(--purple);
  font-weight: 800;
}

/* ====== Final CTA ====== */
.final-cta {
  text-align: center;
  padding-top: 16px;
}
.final-cta h3 {
  font-size: clamp(1.6rem, 3.2vw, 2.2rem);
  margin: 0 0 8px;
}
.final-cta p {
  color: var(--muted);
  margin-bottom: 12px;
}
.final-cta .hero-cta {
  justify-content: center;
  text-align: center;
}

/* ====== Accessibility Helper ====== */
.sr-only {
  position: absolute !important;
  height: 1px;
  width: 1px;
  overflow: hidden;
  clip: rect(1px, 1px, 1px, 1px);
  white-space: nowrap;
}
