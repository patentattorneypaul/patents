/* ========================================= 
   Global Service Page Styles (svc-*)
   Add to WordPress Global CSS
   Reusable across all service pages
========================================= */

/* Design tokens - extend existing */
:root {
    --svc-primary: #5F27CD;
    --svc-secondary: #E83E8C;
    --svc-accent: #FF6F61;
    --svc-gold: #FFD166;
    --svc-text: #2B2B2B;
    --svc-muted: #6b7280;
    --svc-bg: #ffffff;
    --svc-border: #eef0f4;
    --svc-shadow: 0 10px 30px rgba(0,0,0,0.07);
    --svc-radius: 12px;
    --svc-max-width: 100%;
}
@media (min-width: 768px) {
  :root {
    --svc-max-width: 80%;
  }
}
/* Service page container */
.svc-container {
    max-width: var(--svc-max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6;
    color: var(--svc-text);
}

/* Service hero section */
.svc-hero {
    text-align: center;
    padding: 3rem 0 2rem;
    background: linear-gradient(135deg, rgba(95,39,205,0.03), rgba(232,62,140,0.03));
    border-radius: var(--svc-radius);
    margin-bottom: 3rem;
}

.svc-hero h1 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    background: linear-gradient(135deg, var(--svc-primary), var(--svc-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.svc-hero-subtitle {
    font-size: 1.25rem;
    color: var(--svc-muted);
    max-width: 600px;
    margin: 0 auto 2rem;
}

.svc-hero-image {
    width: 100%;
    max-width: 1400px;
    height: auto;
    border-radius: var(--svc-radius);
    box-shadow: var(--svc-shadow);
}

/* When the hero itself has a bold gradient background, use solid white text */
.svc-hero--contrast { 
  /* you can keep your inline gradient or move it here */
  color: #fff;
}

.svc-hero--contrast h1 {
  background: none;                 /* turn off gradient text */
  -webkit-text-fill-color: #fff;    /* ensure white on Safari/WebKit */
  color: #fff;                      /* fallback */
  text-shadow: 0 2px 8px rgba(0,0,0,.15); /* gentle lift on busy bg */
}

.svc-hero--contrast .svc-hero-subtitle {
  color: #fff;
  opacity: .95;                     /* subtle de-emphasis */
}

/* Definition box */
.definition-box {
  background: rgba(95,39,205,.05);
  border-left:4px solid var(--svc-primary);
  padding:1rem 1.25rem; border-radius:0 8px 8px 0;
  margin-top:.75rem;
}

/* Service content sections */
.svc-section {
    margin: 3rem 0;
}

.svc-section h2 {
    color: var(--svc-primary);
    margin-bottom: 1.5rem;
    font-size: 2rem;
    font-weight: 700;
}

.svc-section h3 {
    color: var(--svc-secondary);
    margin: 2rem 0 1rem;
    font-size: 1.25rem;
    font-weight: 600;
}

/* Service feature grid */
.svc-features {
    display: grid;
    gap: 1.5rem;
    margin: 2rem 0;
}

@media (min-width: 768px) {
    .svc-features {
        grid-template-columns: repeat(2, 1fr);
    }
}

.svc-feature-card {
    background: var(--svc-bg);
    border: 2px solid var(--svc-border);
    border-radius: var(--svc-radius);
    padding: 1.5rem;
    transition: all 0.3s ease;
}

.svc-feature-card:hover {
    border-color: var(--svc-primary);
    transform: translateY(-2px);
    box-shadow: var(--svc-shadow);
}

.svc-feature-card h4 {
    color: var(--svc-primary);
    margin-bottom: 0.5rem;
    font-weight: 600;
}

/* Service buttons (contrast + alignment fix) */

.svc-btn {
    display: inline-flex;
    align-items: center;       /* vertical centering */
    justify-content: center;   /* horizontal centering */
    padding: 14px 24px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 1rem;
    line-height: 1;            /* fix vertical alignment */
	padding-bottom:15px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    margin: 0.5rem 0.5rem 0.5rem 0;
    color: var(--svc-primary); /* default text color */
}

/* Gradient Button */
.svc-btn-primary {
    background: linear-gradient(135deg, var(--svc-secondary), var(--svc-primary));
    color: white;  
    border: none;
    box-shadow: var(--svc-shadow);
}

.svc-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(95,39,205,0.3);
    text-decoration: none;
    color: var(--svc-primary) !important;
}

/* Outline Button */
.svc-btn-secondary {
    border: 2px solid var(--svc-primary);
    color: var(--svc-primary) !important;
    background: white;
}

.svc-btn-secondary:hover {
    background: var(--svc-primary);
    color: white !important; 
    transform: translateY(-2px);
    text-decoration: none;
}

/* Service testimonials */
.svc-testimonial {
    background: var(--svc-bg);
    border-left: 4px solid var(--svc-secondary);
    padding: 2rem;
    margin: 2rem 0;
    border-radius: 0 var(--svc-radius) var(--svc-radius) 0;
    box-shadow: var(--svc-shadow);
    font-style: italic;
    position: relative;
}

.svc-testimonial::before {
    content: '"';
    font-size: 4rem;
    color: var(--svc-secondary);
    position: absolute;
    top: -10px;
    left: 10px;
    opacity: 0.3;
}

.svc-testimonial-author {
    font-weight: 600;
    color: var(--svc-primary);
    margin-top: 1rem;
    font-style: normal;
}



/* Service schedule box */
.svc-schedule {
    background: linear-gradient(135deg, rgba(255,111,97,0.1), rgba(255,209,102,0.1));
    border: 2px solid var(--svc-accent);
    border-radius: var(--svc-radius);
    padding: 2rem;
    margin: 2rem 0;
}

.svc-schedule h3 {
    color: var(--svc-accent);
    margin-bottom: 1rem;
}

.svc-schedule-hours {
    display: grid;
    gap: 0.5rem;
}

.svc-schedule-day {
    display: flex;
    justify-content: space-between;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255,111,97,0.2);
}

.svc-schedule-day:last-child {
    border-bottom: none;
}

/* Service safety box */
.svc-safety {
    background: rgba(232,62,140,0.05);
    border: 2px solid var(--svc-secondary);
    border-radius: var(--svc-radius);
    padding: 2rem;
    margin: 2rem 0;
}

.svc-safety h3 {
    color: var(--svc-secondary);
    margin-bottom: 1rem;
}

/* Service pricing hint */
.svc-pricing-note {
    background: rgba(95,39,205,0.05);
    border-left: 4px solid var(--svc-primary);
    padding: 1rem 1.5rem;
    margin: 1rem 0;
    border-radius: 0 8px 8px 0;
    font-style: italic;
    color: var(--svc-muted);
}

/* Service separators */
.svc-separator {
    border: 0;
    height: 2px;
    width: 75%;
    margin: 3rem auto;
    background: linear-gradient(to right, var(--svc-secondary), var(--svc-primary), var(--svc-accent), var(--svc-gold));
    border-radius: 20px;
}

/* Service contact footer */
.svc-contact {
    text-align: center;
    padding: 3rem 0;
    background: linear-gradient(135deg, rgba(95,39,205,0.03), rgba(232,62,140,0.03));
    border-radius: var(--svc-radius);
    margin-top: 3rem;
}

.svc-contact h2 {
    margin-bottom: 1rem;
    color: var(--svc-primary);
}

.svc-contact p {
    color: var(--svc-muted);
    margin-bottom: 2rem;
}

/* Responsive design */
@media (max-width: 768px) {
    .svc-container {
        padding: 0 1rem;
    }
    
    .svc-hero {
        padding: 2rem 1rem;
    }
    
    .svc-callout,
    .svc-feature-card,
    .svc-testimonial {
        padding: 1.5rem;
    }
    
    .svc-btn {
        display: block;
        margin: 0.5rem 0;
        text-align: center;
    }
}

