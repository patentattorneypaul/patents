/* =========================================
   SSF.Fit — Global Styles & Tokens
   ========================================= */

/* ------ Design Tokens (site-wide) ------ */
:root {
  --magenta: #E83E8C;
  --purple:  #5F27CD;
  --coral:   #FF6F61;
  --gold:    #FFD166;

  --text:    #2B2B2B;
  --muted:   #6b7280;
  --bg:      #ffffff;

  --border:  #eef0f4;
  --shadow:  0 10px 30px rgba(0,0,0,0.07);
}

/* =========================================
   Separators
   ========================================= */
hr.wp-block-separator.line-color,
.wp-block-separator.ss-gradient-separator {
  border: 0 !important;
  border-top: 0 !important;
  height: 2px;
  width: 75%;
  margin: 2rem auto;
  background-image: linear-gradient(
    to right,
    #E83E8C 0%,
    #5F27CD 33%,
    #FF6F61 66%,
    #FFD166 100%
  ) !important;
  background-color: transparent !important;
  opacity: 1 !important;
  display: block;
  border-radius: 20px;
}

/* =========================================
   Global Button System
   (Primary / Secondary / Tertiary + Link)
   ========================================= */
.btn-primary,
.btn-secondary,
.btn-tertiary,
.btn-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px 18px;
  border-radius: 999px;
  font-weight: 700;
  font-size: 0.95rem;
  text-decoration: none;
  cursor: pointer;
  transition:
    transform .15s ease,
    box-shadow .3s ease,
    background .3s ease,
    color .3s ease,
    border-color .3s ease;
}

/* Primary (Gradient / Highest Priority) */
.btn-primary {
  background: linear-gradient(135deg, var(--magenta), var(--purple));
  color: #fff;
  border: none;
  box-shadow: var(--shadow);
}
.btn-primary:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 25px rgba(232, 62, 140, 0.35);
  text-decoration: none;
}

/* Secondary (Outlined Purple) */
.btn-secondary {
  border: 2px solid var(--purple);
  color: var(--purple);
  background: #fff;
}
.btn-secondary:hover {
  background: var(--purple);
  color: #fff;
  transform: translateY(-1px);
  box-shadow: var(--shadow);
  text-decoration: none;
}

/* Tertiary (Light Purple Pill — Option C) */
.btn-tertiary {
  background: rgba(95, 39, 205, 0.08); /* faint purple */
  color: var(--purple);
  border: 1.5px solid rgba(95, 39, 205, 0.15);
}
.btn-tertiary:hover {
  background: rgba(95, 39, 205, 0.15);
  border-color: var(--purple);
  color: var(--purple);
  box-shadow: var(--shadow);
  text-decoration: none;
}

/* Link-style CTA (inline text link that still looks intentional) */
.btn-link {
  padding: 6px 2px;
  border-radius: 6px;
  background: transparent;
  border: none;
  color: var(--purple);
  font-weight: 700;
}
.btn-link:hover {
  text-decoration: underline;
}

/* Optional: keyboard focus visibility */
.btn-primary:focus-visible,
.btn-secondary:focus-visible,
.btn-tertiary:focus-visible,
.btn-link:focus-visible {
  outline: 2px solid var(--purple);
  outline-offset: 2px;
}

/* =========================================
   Entry Title (global hero-like post/page title)
   ========================================= */
.entry-title {
	font-size: 2.5em;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif !important;
  font-weight: 800 !important;
  line-height: 1.1 !important;
  color: #1a252f !important;
  text-align: center !important;
  padding: 2rem 1rem 1rem !important;
  position: relative !important;
  letter-spacing: -0.02em !important;
  background-image: linear-gradient(135deg, #2c3e50 0%, #3498db 50%, #e74c3c 100%) !important;
  -webkit-background-clip: text !important;
  -webkit-text-fill-color: transparent !important;
  background-clip: text !important;
  text-shadow: none !important;
  background-color: rgba(255, 255, 255, 0.95) !important;
}

/* Accent bar under entry title */
.entry-title::after {
  content: '' !important;
  display: block !important;
  width: 120px !important;
  height: 6px !important;
  background: linear-gradient(90deg, #3498db 0%, #e74c3c 50%, #f39c12 100%) !important;
  margin: 0.5rem auto 2rem !important;
  border-radius: 3px !important;
  box-shadow: 0 2px 10px rgba(52, 152, 219, 0.3) !important;
  animation: pulse-glow 2s infinite alternate !important;
	animation: none !important; 
}

/* Subtle background sweep behind title */
.entry-title::before {
  content: '' !important;
  position: absolute !important;
  top: 0 !important;
  left: 50% !important;
  transform: translateX(-50%) !important;
  width: 100% !important;
  height: 100% !important;
  background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(52,152,219,0.05) 100%) !important;
  z-index: -1 !important;
  border-bottom: 1px solid rgba(52, 152, 219, 0.1) !important;
	background: white !important;
}

@keyframes pulse-glow {
  0% {
    box-shadow: 0 2px 10px rgba(52, 152, 219, 0.3);
    transform: scaleX(1);
  }
  100% {
    box-shadow: 0 4px 20px rgba(52, 152, 219, 0.5);
    transform: scaleX(1.05);
  }
}

/* Responsive entry title tweaks */
@media (max-width: 768px) {
  .entry-title {
		font-size: 1.75em;
    padding: 1.5rem 1rem 0.8rem !important;
    margin: 0.5rem auto 0.5rem !important;
  }
  .entry-title::after {
    width: 100px !important;
    height: 5px !important;
    margin: 0.3rem auto 1.5rem !important;
  }
}
@media (max-width: 480px) {
  .entry-title {
    padding: 1rem 0.5rem 0.5rem !important;
    margin: 0.3rem auto 0.3rem !important;
  }
